<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <ImageView
            android:id="@+id/station_logo_player"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Station Logo Player"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@tools:sample/avatars" />

        <TextView
            android:id="@+id/station_name_player"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            app:layout_constraintEnd_toStartOf="@id/close_button"
            app:layout_constraintStart_toEndOf="@id/station_logo_player"
            app:layout_constraintTop_toTopOf="@id/station_logo_player"
            tools:text="Classic 105" />

        <TextView
            android:id="@+id/station_signal_player"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@id/station_name_player"
            app:layout_constraintStart_toStartOf="@id/station_name_player"
            app:layout_constraintTop_toBottomOf="@id/station_name_player"
            tools:text="105.2 FM" />

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Stop and close player"
            android:src="@drawable/ic_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.media3.ui.PlayerControlView
            android:id="@+id/player_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/station_logo_player"
            app:show_fastforward_button="false"
            app:show_rewind_button="false"
            app:show_shuffle_button="false"
            app:show_subtitle_button="false"
            app:show_timeout="0"
            app:show_vr_button="false" />

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/cast_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/player_view" />

        <TextView
            android:id="@+id/cast_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceCaption"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/cast_button"
            app:layout_constraintStart_toEndOf="@id/cast_button"
            app:layout_constraintTop_toTopOf="@id/cast_button"
            tools:text="Living Room TV"
            tools:visibility="visible" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>