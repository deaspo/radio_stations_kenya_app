<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.KenyanRadioStations" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_mauve</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- This tells the toolbar to use a theme with white icons and text -->
<!--        <item name="android:toolbarStyle">@style/ThemeOverlay.MaterialComponents.Light</item>-->
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background color -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Set the icon to be displayed -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <!-- Set the theme to be applied after the splash screen is gone -->
        <item name="postSplashScreenTheme">@style/Base.Theme.KenyanRadioStations</item>
    </style>

    <style name="Theme.KenyanRadioStations" parent="Base.Theme.KenyanRadioStations" />
</resources>