<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.KenyanRadioStations" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/md_surface_inverse</item>
        <item name="colorOnSurfaceInverse">@color/md_on_surface_inverse</item>

        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="android:colorEdgeEffect">@color/md_primary</item>

        <!-- Tokens Material has no role for -->
        <item name="colorLiveDot">@color/live_dot</item>
        <item name="colorSurfaceRaised">@color/md_surface_raised</item>

        <!--
            Off in both themes. In dark, Material would otherwise tint every
            elevated surface towards primary by its elevation, on top of the
            tonal ladder in values-night/colors.xml - two systems deciding one
            colour. The ladder is explicit; let it be the only one.
        -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSnackbarBg">@color/snackbar_bg</item>
        <item name="colorSnackbarOn">@color/snackbar_on</item>
        <item name="colorSnackbarAction">@color/snackbar_action</item>

        <!--
            Editorial display face, applied through the two text roles that are
            genuinely display-scale. titleMedium and below stay sans on purpose:
            a serif in a dense list or a settings row is harder to read, not
            more characterful.
        -->
        <item name="textAppearanceHeadlineSmall">@style/Text.App.Headline</item>
        <item name="textAppearanceTitleLarge">@style/Text.App.Title</item>

        <!-- Shape scale -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Sm</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Md</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.Lg</item>

        <!-- Snackbar: container, text and action are three separate styles -->
        <item name="snackbarStyle">@style/Widget.App.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.App.Snackbar.TextView</item>
        <item name="snackbarButtonStyle">@style/Widget.App.Snackbar.Button</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog</item>

        <!--
            targetSdk 36 means Android 15+ draws edge-to-edge and ignores
            android:statusBarColor / navigationBarColor entirely. Insets are
            applied in MainActivity instead; these two just keep older
            releases transparent so the same layout works there.
        -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/window_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/window_light_system_bars</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.KenyanRadioStations</item>
    </style>

    <style name="Theme.KenyanRadioStations" parent="Base.Theme.KenyanRadioStations" />

    <!-- Mini player sits on the bottom edge: round only the top corners -->
    <style name="ShapeAppearance.App.PlayerSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>
