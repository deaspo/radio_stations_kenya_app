<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3 light colour roles, derived from the app logo's mauve (#A75B87).
    The old purple_*/teal_* template colours are gone: they were Material 2 roles
    that Theme.Material3 ignores, and #e0b0ff with white text failed contrast.
-->
<resources>

    <!-- Brand seed, kept for reference / splash artwork -->
    <color name="brand_mauve">#A75B87</color>

    <color name="md_primary">#7B3F5F</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#FFD8E8</color>
    <color name="md_on_primary_container">#33132A</color>

    <color name="md_secondary">#6F5B64</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#F8DEE8</color>
    <color name="md_on_secondary_container">#281620</color>

    <color name="md_tertiary">#7D5636</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#FFDCC2</color>
    <color name="md_on_tertiary_container">#2F1600</color>

    <color name="md_error">#B3261E</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#F9DEDC</color>
    <color name="md_on_error_container">#410E0B</color>

    <color name="md_background">#FFF8FA</color>
    <color name="md_on_background">#1F1A1C</color>
    <color name="md_surface">#FFF8FA</color>
    <color name="md_on_surface">#1F1A1C</color>
    <color name="md_surface_variant">#F0DEE5</color>
    <color name="md_on_surface_variant">#4F444A</color>
    <color name="md_surface_inverse">#352F31</color>
    <color name="md_on_surface_inverse">#F9EEF1</color>

    <color name="md_outline">#817680</color>
    <color name="md_outline_variant">#D3C2C9</color>

    <!-- Matches the white plate baked into ic_splash_logo, in both themes -->
    <color name="splash_background">#FFFFFF</color>
</resources>
