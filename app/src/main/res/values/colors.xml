<?xml version="1.0" encoding="utf-8"?>
<!--
    Mauve Editorial - light tokens.

    One tonal ramp, hue taken from the logo (H~340, S~0.30), used for both
    themes. values-night/colors.xml overrides the same names with the dark end of
    the same ramp, which is what makes dark mode a re-skin rather than a second
    design.

    The brand/primary split below is the one thing in this file not to "tidy":
    the logo colour does not pass 4.5:1 as text, so it is kept for artwork only
    and text uses one ramp step deeper. Contrast figures are measured, not
    estimated, and are quoted against the surface the colour actually sits on.
-->
<resources>

    <!--
        Brand. Logo, splash mark, tile artwork. 4.27:1 on the light surface -
        fine for large graphics, NOT for text or icons. Never use it as a text
        colour; that is what md_primary is for.
    -->
    <color name="brand_mauve">#A75B87</color>

    <!-- primary: same hue, one step deeper. 5.35:1 on surface, 5.86:1 on white -->
    <color name="md_primary">#964C74</color>
    <color name="md_on_primary">#FFF7FB</color>
    <color name="md_primary_container">#EDDEE7</color>
    <color name="md_on_primary_container">#21121B</color>

    <color name="md_secondary">#6E5A68</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#F3E6EE</color>
    <color name="md_on_secondary_container">#241A21</color>

    <color name="md_tertiary">#5E548E</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#E5E0F2</color>
    <color name="md_on_tertiary_container">#1B1733</color>

    <!-- error: 6.46:1 on white, 5.89:1 on surface -->
    <color name="md_error">#BA1A1A</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#FFDAD6</color>
    <color name="md_on_error_container">#3B0F0A</color>

    <!-- surface: warm paper, not clinical white -->
    <color name="md_background">#F8F3F7</color>
    <color name="md_on_background">#241A21</color>
    <color name="md_surface">#F8F3F7</color>
    <color name="md_on_surface">#241A21</color>
    <!-- cards, fields, rows, mini player -->
    <color name="md_surface_variant">#FFFFFF</color>
    <color name="md_on_surface_variant">#6E5A68</color>
    <color name="md_surface_inverse">#3A2A34</color>
    <color name="md_on_surface_inverse">#F4ECEF</color>

    <!-- decorative 1dp borders; not held to a text ratio -->
    <color name="md_outline">#E4D8E1</color>
    <color name="md_outline_variant">#EFE7ED</color>

    <!-- snackbar: the offline / site-down retry -->
    <color name="snackbar_bg">#3A2A34</color>
    <color name="snackbar_on">#F4ECEF</color>
    <color name="snackbar_action">#E3B3CD</color>

    <!--
        Live dot. Decorative only - 7-9dp, pulsing, and every place it appears
        the same fact is also in text ("Live", "Now playing"). It is never the
        only signal, which is why it is not held to 4.5:1.
    -->
    <color name="live_dot">#C96295</color>

    <color name="md_scrim">#241A21</color>

    <!--
        Station artwork gradients. Theme-independent by design: a station looks
        the same in light and dark, and the same for every user, so they are
        NOT overridden in values-night.
    -->
    <color name="art_01_a">#8D4A6F</color><color name="art_01_b">#C886AB</color>
    <color name="art_02_a">#3E5C76</color><color name="art_02_b">#748CAB</color>
    <color name="art_03_a">#5B7553</color><color name="art_03_b">#A3B18A</color>
    <color name="art_04_a">#9C6644</color><color name="art_04_b">#D4A373</color>
    <color name="art_05_a">#5E548E</color><color name="art_05_b">#9F86C0</color>
    <color name="art_06_a">#31555E</color><color name="art_06_b">#6B8E9B</color>

    <!-- Matches the white plate baked into ic_splash_logo, in both themes -->
    <color name="splash_background">#FFFFFF</color>
</resources>
