<?xml version="1.0" encoding="utf-8"?>
<!-- An explicit size so this also works as a compound drawable on a label,
     where there is no layout to give it bounds. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/colorOnPrimary" />
    <size
        android:width="8dp"
        android:height="8dp" />
</shape>
