<?xml version="1.0" encoding="utf-8"?>
<!--
    The live dot. Decorative only: everywhere it appears, the same fact is also
    in text ("Live", "Now playing"), so it is never the sole signal and is not
    held to a text contrast ratio.

    An explicit size so this also works as a compound drawable on a label, where
    there is no layout to give it bounds.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/colorLiveDot" />
    <size
        android:width="8dp"
        android:height="8dp" />
</shape>
